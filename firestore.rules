rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Common helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'thekathavahini@gmail.com' ||
        request.auth.token.email == 'kathavahini@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         getUserData().role == 'admin')
      );
    }

    function isWriter() {
      return isAuthenticated() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         getUserData().role == 'writer' &&
         getUserData().status == 'active')
      );
    }

    // Secure Content Ownership Helper: Evaluates authorId, writerId, ownerId, submittedBy, and author.id
    function isContentOwner(data) {
      return isAuthenticated() && (
        data.authorId == request.auth.uid ||
        data.writerId == request.auth.uid ||
        data.ownerId == request.auth.uid ||
        data.submittedBy == request.auth.uid ||
        (data.author != null && data.author.id == request.auth.uid)
      );
    }

    // Helper to check parent story ownership for subcollections
    function isStoryParentOwner(storyId) {
      return isAuthenticated() && exists(/databases/$(database)/documents/stories/$(storyId)) &&
        isContentOwner(get(/databases/$(database)/documents/stories/$(storyId)).data);
    }

    // Helper to check parent novel ownership for subcollections
    function isNovelParentOwner(novelId) {
      return isAuthenticated() && exists(/databases/$(database)/documents/novels/$(novelId)) &&
        isContentOwner(get(/databases/$(database)/documents/novels/$(novelId)).data);
    }

    // Canonical Users collection
    match /users/{userId} {
      allow read: if true;
      allow create: if (isOwner(userId)
        && ((request.resource.data.role == 'reader' && request.resource.data.status == 'active') || 
            (request.resource.data.role == 'writer' && request.resource.data.status == 'pending'))
        && request.resource.data.uid == userId) || isAdmin();
      allow update: if isAdmin() || (
        isOwner(userId) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status', 'uid', 'createdAt']))
      );
      allow delete: if isAdmin();

      // User Subcollections
      match /bookmarks/{storyId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /following/{authorId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /readingHistory/{storyId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /notifications/{notifId} {
        allow read, update, delete: if isOwner(userId) || isAdmin();
        allow create: if isAuthenticated();
      }

      match /dismissedAnnouncements/{announcementId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // Role-specific collections
    match /readers/{readerId} {
      allow read: if true;
      allow write: if isOwner(readerId) || isAdmin();
    }

    match /writers/{writerId} {
      allow read: if true;
      allow create: if isOwner(writerId) || isAdmin();
      allow update: if isAdmin() || (isOwner(writerId) && isWriter() && request.resource.data.status == resource.data.status);
      allow delete: if isAdmin();

      // Daily Submission Limit Tracker subcollection
      match /dailySubmissions/{dateDoc} {
        allow read: if isOwner(writerId) || isAdmin();
        allow create: if (isOwner(writerId) && isWriter()) || isAdmin();
        allow update, delete: if isAdmin();
      }
    }

    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }

    match /authors/{authorId} {
      allow read: if true;
      allow create: if isOwner(authorId) || isAdmin();
      allow update: if isAdmin() || (isOwner(authorId) && isWriter());
      allow delete: if isAdmin();
    }

    // Writer Applications
    match /writerApplications/{appId} {
      allow read: if isAuthenticated() && (
        resource.data.applicantUid == request.auth.uid || isAdmin()
      );
      allow create: if isAuthenticated()
        && request.resource.data.applicantUid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ---------------------------------------------------------------------------
    // 1. STORIES: ADMIN (ALL ACCESS) vs WRITER (OWN CONTENT ONLY)
    // ---------------------------------------------------------------------------
    match /stories/{storyId} {
      // Public read for published public stories; author & admin can read all states
      allow read: if ((resource.data.status == 'published' || resource.data.status == 'approved') && 
                      (resource.data.visibility == 'public' || resource.data.visibility == null)) || (
        isAdmin() || isContentOwner(resource.data)
      );
      
      // Create: Admin or Writer creating for themselves
      allow create: if isAdmin() || (
        isWriter() && (
          request.resource.data.authorId == request.auth.uid ||
          request.resource.data.writerId == request.auth.uid ||
          request.resource.data.ownerId == request.auth.uid
        )
      );
      
      // Update: Admin can update anything; Writer can only update their own story; Public can update counters
      allow update: if isAdmin() || (
        isWriter()
        && isContentOwner(resource.data)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['authorId', 'writerId', 'ownerId', 'createdAt', 'approvedAt', 'approvedBy'])
      ) || (
        // Allow public like/view/rating/bookmark counter updates
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount', 'viewsCount', 'likeCount', 'likesCount', 'rating', 'ratingsCount', 'ratingsSum', 'bookmarkCount', 'bookmarksCount', 'commentsCount', 'sharesCount', 'updatedAt'])
      );
      
      // Delete: Admin or Author/Writer owner only
      allow delete: if isAdmin() || (isWriter() && isContentOwner(resource.data));

      // Subcollections: Content chunks, pages, documents, episodes
      match /contentChunks/{chunkId} {
        allow read: if true;
        allow write: if isAdmin() || (isWriter() && isStoryParentOwner(storyId));
      }

      match /pages/{pageId} {
        allow read: if true;
        allow write: if isAdmin() || (isWriter() && isStoryParentOwner(storyId));
      }

      match /documents/{documentId} {
        allow read: if true;
        allow write: if isAdmin() || (isWriter() && isStoryParentOwner(storyId));
      }

      match /episodes/{episodeId} {
        allow read: if true;
        allow write: if isAdmin() || (isWriter() && isStoryParentOwner(storyId));

        match /pages/{pageId} {
          allow read: if true;
          allow write: if isAdmin() || (isWriter() && isStoryParentOwner(storyId));
        }

        match /documents/{docId} {
          allow read: if true;
          allow write: if isAdmin() || (isWriter() && isStoryParentOwner(storyId));
        }
      }

      // Comments subcollection
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated();
        allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      }

      // Likes subcollection
      match /likes/{likeUid} {
        allow read: if true;
        allow write: if isAuthenticated() && (request.auth.uid == likeUid || isAdmin());
      }

      // Ratings subcollection
      match /ratings/{ratingUid} {
        allow read: if true;
        allow write: if isAuthenticated() && (request.auth.uid == ratingUid || isAdmin());
      }
    }

    // Deleted Items tracker for sync across all clients and sessions
    match /deletedItems/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------------------------------------------------------------------------
    // 2. NOVELS: ADMIN (ALL ACCESS) vs WRITER (OWN CONTENT ONLY)
    // ---------------------------------------------------------------------------
    match /novels/{novelId} {
      allow read: if true;
      
      allow create: if isAdmin() || (
        isWriter() && (
          request.resource.data.authorId == request.auth.uid ||
          request.resource.data.writerId == request.auth.uid ||
          request.resource.data.ownerId == request.auth.uid ||
          (request.resource.data.author != null && request.resource.data.author.id == request.auth.uid)
        )
      );
      
      allow update: if isAdmin() || (
        isWriter()
        && isContentOwner(resource.data)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['authorId', 'writerId', 'ownerId', 'createdAt'])
      ) || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewsCount', 'viewCount', 'likesCount', 'likeCount', 'rating', 'ratingsCount', 'bookmarkCount', 'bookmarksCount', 'updatedAt'])
      );
      
      allow delete: if isAdmin() || (isWriter() && isContentOwner(resource.data));

      match /chapters/{chapterId} {
        allow read: if true;
        allow write: if isAdmin() || (isWriter() && isNovelParentOwner(novelId));
      }
    }

    // ---------------------------------------------------------------------------
    // 3. EPISODES: ADMIN (ALL ACCESS) vs WRITER (OWN CONTENT ONLY)
    // ---------------------------------------------------------------------------
    match /episodes/{episodeId} {
      allow read: if true;
      
      allow create: if isAdmin() || (
        isWriter() && (
          request.resource.data.authorId == request.auth.uid ||
          request.resource.data.writerId == request.auth.uid ||
          request.resource.data.ownerId == request.auth.uid ||
          (request.resource.data.author != null && request.resource.data.author.id == request.auth.uid)
        )
      );
      
      allow update: if isAdmin() || (
        isWriter()
        && isContentOwner(resource.data)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['authorId', 'writerId', 'ownerId', 'createdAt'])
      ) || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewsCount', 'viewCount', 'likesCount', 'likeCount', 'rating', 'updatedAt'])
      );
      
      allow delete: if isAdmin() || (isWriter() && isContentOwner(resource.data));
    }

    // ---------------------------------------------------------------------------
    // 4. JOKES: ADMIN (ALL ACCESS) vs CREATOR/WRITER (OWN CONTENT ONLY)
    // ---------------------------------------------------------------------------
    match /jokes/{jokeId} {
      allow read: if true;
      
      allow create: if isAuthenticated() && (
        request.resource.data.submittedBy == request.auth.uid ||
        request.resource.data.authorId == request.auth.uid ||
        request.resource.data.ownerId == request.auth.uid ||
        isAdmin()
      );
      
      allow update: if isAdmin() || (
        isAuthenticated()
        && isContentOwner(resource.data)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['submittedBy', 'authorId', 'ownerId', 'createdAt'])
      ) || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'likes', 'viewsCount', 'sharesCount', 'updatedAt'])
      );
      
      allow delete: if isAdmin() || (isAuthenticated() && isContentOwner(resource.data));
    }

    // ---------------------------------------------------------------------------
    // 5. KNOWLEDGE: ADMIN (ALL ACCESS) vs WRITER (OWN CONTENT ONLY)
    // ---------------------------------------------------------------------------
    match /knowledge/{knowledgeId} {
      allow read: if true;
      
      allow create: if isAdmin() || (
        isWriter() && (
          request.resource.data.authorId == request.auth.uid ||
          request.resource.data.submittedBy == request.auth.uid ||
          request.resource.data.ownerId == request.auth.uid
        )
      );
      
      allow update: if isAdmin() || (
        isWriter()
        && isContentOwner(resource.data)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['authorId', 'submittedBy', 'ownerId', 'createdAt'])
      ) || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewsCount', 'viewCount', 'likesCount', 'likeCount', 'sharesCount', 'updatedAt'])
      );
      
      allow delete: if isAdmin() || (isWriter() && isContentOwner(resource.data));
    }

    // Samethalu (Telugu Proverbs) collection
    match /samethalu/{samethaId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Topics collection
    match /topics/{topicId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Categories collection
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Issue Reports
    match /issueReports/{reportId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Contact Submissions
    match /contactSubmissions/{submissionId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Admin Audit Logs
    match /adminAuditLogs/{logId} {
      allow create: if isAuthenticated();
      allow read: if isAdmin();
      allow update, delete: if false; // Immutable audit log
    }

    // Announcements collection
    match /announcements/{announcementId} {
      // Public / Authenticated read based on audience and status
      allow read: if isAdmin() || (
        (resource.data.status == 'published' || resource.data.status == 'scheduled') && (
          resource.data.audience == 'everyone' ||
          (resource.data.audience == 'readers' && isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == 'reader') ||
          (resource.data.audience == 'writers' && isAuthenticated() && isWriter()) ||
          (resource.data.audience == 'readers_and_writers' && isAuthenticated() && (
            (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == 'reader') || isWriter()
          ))
        )
      );
      // Only Admin can create, update, delete announcements
      allow write: if isAdmin();
    }

    // ---------------------------------------------------------------------------
    // 6. BALAVINODHINI ECOSYSTEM - EXCLUSIVE ADMIN MANAGEMENT (NO WRITER ACCESS)
    // ---------------------------------------------------------------------------
    match /balavinodhini/{itemId} {
      // Public read for all published Balavinodhini children content
      allow read: if true;
      // ONLY Admin has access to create, edit, update, or delete (No writer access)
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        // Allow public reader like/views counter updates
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'views', 'shares', 'likesCount', 'viewsCount', 'bookmarkCount', 'commentCount', 'updatedAt'])
      );

      // Comments subcollection
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated();
        allow update, delete: if isAdmin();
      }
    }

    match /balavinodhini_games/{gameId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /balavinodhini_quizzes/{quizId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /balavinodhini_riddles/{riddleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /balavinodhini_creations/{creationId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Fallback: Admin unrestricted
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
