rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Common helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'thekathavahini@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         getUserData().role == 'admin')
      );
    }

    function isWriter() {
      return isAuthenticated() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         getUserData().role == 'writer' &&
         getUserData().status == 'active')
      );
    }

    // Canonical Users collection
    match /users/{userId} {
      allow read: if true;
      allow create: if (isOwner(userId)
        && ((request.resource.data.role == 'reader' && request.resource.data.status == 'active') || 
            (request.resource.data.role == 'writer' && request.resource.data.status == 'pending'))
        && request.resource.data.uid == userId) || isAdmin();
      allow update: if isAdmin() || (
        isOwner(userId) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status', 'uid', 'createdAt']))
      );
      allow delete: if isAdmin();

      // User Subcollections
      match /bookmarks/{storyId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /following/{authorId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /readingHistory/{storyId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /notifications/{notifId} {
        allow read, update, delete: if isOwner(userId) || isAdmin();
        allow create: if isAuthenticated();
      }

      match /dismissedAnnouncements/{announcementId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // Role-specific collections
    match /readers/{readerId} {
      allow read: if true;
      allow write: if isOwner(readerId) || isAdmin();
    }

    match /writers/{writerId} {
      allow read: if true;
      allow create: if isOwner(writerId) || isAdmin();
      allow update: if isAdmin() || (isOwner(writerId) && isWriter() && request.resource.data.status == resource.data.status);
      allow delete: if isAdmin();

      // Daily Submission Limit Tracker subcollection
      match /dailySubmissions/{dateDoc} {
        allow read: if isOwner(writerId) || isAdmin();
        allow create: if (isOwner(writerId) && isWriter()) || isAdmin();
        allow update, delete: if isAdmin();
      }
    }

    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }

    match /authors/{authorId} {
      allow read: if true;
      allow create: if isOwner(authorId) || isAdmin();
      allow update: if isAdmin() || (isOwner(authorId) && isWriter());
      allow delete: if isAdmin();
    }

    // Writer Applications
    match /writerApplications/{appId} {
      allow read: if isAuthenticated() && (
        resource.data.applicantUid == request.auth.uid || isAdmin()
      );
      allow create: if isAuthenticated()
        && request.resource.data.applicantUid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Stories collection
    match /stories/{storyId} {
      // Public read for published public stories; author & admin can read all states
      allow read: if ((resource.data.status == 'published' || resource.data.status == 'approved') && 
                      (resource.data.visibility == 'public' || resource.data.visibility == null)) || (
        isAuthenticated() && (resource.data.authorId == request.auth.uid || resource.data.writerId == request.auth.uid || isAdmin())
      );
      allow create: if isWriter()
        && (request.resource.data.authorId == request.auth.uid || request.resource.data.writerId == request.auth.uid || isAdmin());
      allow update: if isAdmin() || (
        isWriter()
        && (resource.data.authorId == request.auth.uid || resource.data.writerId == request.auth.uid)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'visibility', 'authorId', 'writerId', 'createdAt', 'approvedAt', 'approvedBy'])
      ) || (
        // Allow public like/view/rating/bookmark counter updates
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount', 'viewsCount', 'likeCount', 'likesCount', 'rating', 'ratingsCount', 'ratingsSum', 'bookmarkCount', 'bookmarksCount', 'commentsCount', 'updatedAt'])
      );
      allow delete: if isAdmin() || (
        isWriter() && (resource.data.authorId == request.auth.uid || resource.data.writerId == request.auth.uid)
      );

      // Comments subcollection
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated();
        allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      }

      // Likes subcollection
      match /likes/{likeUid} {
        allow read: if true;
        allow write: if isAuthenticated() && (request.auth.uid == likeUid || isAdmin());
      }

      // Ratings subcollection
      match /ratings/{ratingUid} {
        allow read: if true;
        allow write: if isAuthenticated() && (request.auth.uid == ratingUid || isAdmin());
      }
    }

    // Deleted Items tracker for sync across all clients and sessions
    match /deletedItems/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Novels collection
    match /novels/{novelId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() || isWriter();

      match /chapters/{chapterId} {
        allow read: if true;
        allow create, update, delete: if isAdmin() || isWriter();
      }
    }

    // Episodes collection
    match /episodes/{episodeId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() || isWriter();
    }

    // Jokes collection
    match /jokes/{jokeId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() || isAdmin();
      allow delete: if isAdmin();
    }

    // Samethalu (Telugu Proverbs) collection
    match /samethalu/{samethaId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Topics collection
    match /topics/{topicId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Knowledge collection
    match /knowledge/{knowledgeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Categories collection
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Issue Reports
    match /issueReports/{reportId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Contact Submissions
    match /contactSubmissions/{submissionId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Admin Audit Logs
    match /adminAuditLogs/{logId} {
      allow create: if isAuthenticated();
      allow read: if isAdmin();
      allow update, delete: if false; // Immutable audit log
    }

    // Announcements collection
    match /announcements/{announcementId} {
      // Public / Authenticated read based on audience and status
      allow read: if isAdmin() || (
        (resource.data.status == 'published' || resource.data.status == 'scheduled') && (
          resource.data.audience == 'everyone' ||
          (resource.data.audience == 'readers' && isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == 'reader') ||
          (resource.data.audience == 'writers' && isAuthenticated() && isWriter()) ||
          (resource.data.audience == 'readers_and_writers' && isAuthenticated() && (
            (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == 'reader') || isWriter()
          ))
        )
      );
      // Only Admin can create, update, delete announcements
      allow write: if isAdmin();
    }

    // ---------------------------------------------------------------------------
    // BALAVINODHINI ECOSYSTEM COLLECTIONS
    // ---------------------------------------------------------------------------
    match /balavinodhini/{itemId} {
      // Public read for published and approved content
      allow read: if true;
      // Allow authenticated user to create creation / submission or like/comment
      allow create: if isAuthenticated() || isAdmin();
      // Allow author or admin to update/delete
      allow update: if isAdmin() || (isAuthenticated() && resource.data.authorId == request.auth.uid) || true; // allow like counter updates
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.authorId == request.auth.uid);

      // Comments subcollection
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated() || true;
        allow update, delete: if isAdmin();
      }
    }

    match /balavinodhini_games/{gameId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /balavinodhini_quizzes/{quizId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /balavinodhini_riddles/{riddleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /balavinodhini_creations/{creationId} {
      allow read: if true;
      allow create: if isAuthenticated() || true;
      allow update: if isAdmin() || (isAuthenticated() && resource.data.authorId == request.auth.uid);
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.authorId == request.auth.uid);
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Fallback: Admin unrestricted
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
