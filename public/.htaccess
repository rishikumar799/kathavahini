<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Do not rewrite existing files or directories (including /assets/*.js, /assets/*.css, /logo.png)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Never return index.html for missing static asset files or /assets/* or /api/* (return real 404)
  RewriteRule ^assets/ - [R=404,L]
  RewriteRule ^api/ - [R=404,L]
  RewriteRule \.(?:js|mjs|css|map|png|jpe?g|webp|gif|svg|ico|woff2?|ttf|eot|json|xml|txt|pdf)$ - [R=404,L]

  # Rewrite all SPA routes (/story/*, /novel/*, /author/*, /profile/*, /episode/*) to /index.html
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Always revalidate index.html so browsers fetch the newest hashed /assets/* bundles after every deploy
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
  </FilesMatch>

  # Cache content-hashed static assets long-term
  <FilesMatch "\.(?:js|css|woff2?|png|jpe?g|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
